# Copy to .env and fill in. Never commit .env.

# --- API keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GNEWS_API_KEY=
YOUTUBE_API_KEY=
ELEVENLABS_API_KEY=

# --- Models (change here, not in code) ---
PROFILE_MODEL=claude-haiku-5-5
SUMMARIZER_MODEL=claude-sonnet-5-5
HIGHLIGHTS_MODEL=claude-haiku-5-5
FACTCHECK_MODEL=gpt-6
TTS_MODEL=gpt-4o-mini-tts
EMBEDDING_MODEL=BAAI/bge-m3

# --- App ---
DATABASE_PATH=data/daily_brief.db
STORIES_PER_DIGEST=15
# Set to 1 to run every stage with placeholder data and no API calls
OFFLINE_MODE=1
